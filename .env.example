DATABASE_URL=sqlite:///investment_intelligence.db
# For PostgreSQL, use: postgresql+psycopg2://user:password@localhost:5432/investment_intelligence

# LLM analysis (required for AI thesis, triggers, and event evaluation)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# Optional: use Azure OpenAI or other compatible endpoint
# OPENAI_BASE_URL=https://your-endpoint.openai.azure.com/openai/v1

# Email alerts (use an app password for Gmail / Outlook SMTP; do not commit this file)
ALERT_RECIPIENT=you@example.com
ALERT_FROM=you@example.com
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your-app-password

# Optional headless monitor configuration
MONITOR_COMPANY=Vodafone Idea
MONITOR_TICKER=IDEA.NS
MONITOR_INTERVAL_SECONDS=300
